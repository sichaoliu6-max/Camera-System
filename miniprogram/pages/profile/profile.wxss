.profile-page {
  padding: 58rpx 34rpx 120rpx;
}

.brand-row.center {
  display: flex;
  align-items: center;
  gap: 14rpx;
  justify-content: center;
  margin-bottom: 34rpx;
  color: #fff;
}

.brand-dots text {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  margin-right: 8rpx;
  border-radius: 50%;
}

.brand-dots text:nth-child(1) { background: #67d46f; }
.brand-dots text:nth-child(2) { background: #9b9aff; }
.brand-dots text:nth-child(3) { background: #79a7ff; }
.brand-dots text:nth-child(4) { background: #ff7cc2; }
.brand-dots text:nth-child(5) { background: #ffb47f; }

.profile-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 42rpx;
  color: #fff;
}

.avatar {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  align-items: center;
  justify-content: center;
  border-radius: 56rpx;
  background: #fff;
  color: #a07c4f;
  font-size: 44rpx;
  font-weight: 800;
}

.avatar-btn {
  width: 112rpx;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border-radius: 56rpx;
  background: transparent;
  line-height: 1;
}

.avatar-btn::after {
  border: 0;
}

.avatar-img {
  display: block;
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
}

.profile-name {
  margin-top: 10rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.profile-company {
  margin-top: 18rpx;
  color: #a07c4f;
  font-size: 26rpx;
}

.profile-phone {
  margin-top: 8rpx;
  color: #fff;
  font-size: 34rpx;
}

.auth-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
}

.auth-btn {
  height: 58rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
  font-size: 24rpx;
  line-height: 58rpx;
}

.auth-btn::after {
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 999rpx;
}

.language-panel {
  margin-bottom: 30rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background:
    repeating-linear-gradient(135deg, rgba(0, 0, 0, 0.08) 0 14rpx, transparent 14rpx 28rpx),
    #a07c4f;
  color: #fff;
}

.language-picker {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  background: transparent;
}

.profile-panel {
  overflow: hidden;
  border-radius: 22rpx;
  background: #fff;
  color: #202020;
}

.profile-row {
  display: flex;
  min-height: 104rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #eeeeee;
  font-size: 28rpx;
}

.language-panel .profile-row {
  overflow: hidden;
  border-bottom: 0;
  border-radius: 0;
  background: transparent;
  background-color: transparent;
  color: #1f1a14;
  font-weight: 700;
}

.language-value {
  color: #3f382f;
  font-weight: 700;
}

.row-arrow {
  color: #5a5044;
  font-size: 42rpx;
}
