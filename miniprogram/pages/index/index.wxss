.home-page {
  padding-top: 42rpx;
}

.brand {
  text-align: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.welcome {
  margin: 60rpx 0 34rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.apply-entry {
  display: flex;
  min-height: 180rpx;
  align-items: center;
  justify-content: space-between;
}

.entry-title {
  font-size: 42rpx;
  font-weight: 800;
}

.entry-subtitle {
  margin-top: 22rpx;
  font-size: 28rpx;
}

.entry-arrow {
  color: rgba(255, 255, 255, 0.7);
  font-size: 60rpx;
}

.factory-card {
  overflow: hidden;
  margin-top: 70rpx;
  border-radius: 16rpx;
  background: #2d2d2d;
}

.factory-image {
  display: block;
  width: 100%;
  height: 430rpx;
}
