.visit-list-page {
  padding: 42rpx 38rpx 120rpx;
}

.brand-row {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  align-items: center;
  color: #fff;
  font-size: 22rpx;
}

.brand-dots text {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  margin-right: 8rpx;
  border-radius: 50%;
}

.brand-dots text:nth-child(1) { background: #67d46f; }
.brand-dots text:nth-child(2) { background: #9b9aff; }
.brand-dots text:nth-child(3) { background: #79a7ff; }
.brand-dots text:nth-child(4) { background: #ff7cc2; }
.brand-dots text:nth-child(5) { background: #ffb47f; }

.list-panel {
  min-height: 760rpx;
  padding: 38rpx 34rpx;
  border-radius: 22rpx;
  background: #f4f4f4;
}

.count-pill {
  display: inline-flex;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #696969;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.16);
}

.visit-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 22rpx 20rpx;
  border-radius: 34rpx;
  background: #fff;
  color: #6c6c76;
}

.visit-line {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  align-items: center;
  font-size: 26rpx;
}

.small-icon {
  display: inline-flex;
  width: 30rpx;
  height: 30rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #5a9df2;
  color: #fff;
  font-size: 18rpx;
}

.status-inline {
  color: #6f6f78;
}

.visit-time {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.visit-arrow {
  color: #b8b8bd;
  font-size: 44rpx;
}

.empty-text {
  padding: 80rpx 0;
  color: #8b8b8b;
  text-align: center;
}
